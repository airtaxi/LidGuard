<Project>
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>windows-x86;windows-x64;windows-arm64;linux-x64;linux-arm64;macos-x64;macos-arm64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>lidguard</AssemblyName>
    <RootNamespace>LidGuard</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'windows-x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'windows-x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'windows-arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'linux-arm64'">linux-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'macos-x64'">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'macos-arm64'">osx-arm64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <LidGuardTargetPlatform Condition="$([System.String]::Copy('$(Platform)').StartsWith('windows-'))">windows</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="$([System.String]::Copy('$(Platform)').StartsWith('linux-'))">linux</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="$([System.String]::Copy('$(Platform)').StartsWith('macos-'))">macOS</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">windows</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">linux</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">macOS</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and '$(OS)' == 'Windows_NT'">windows</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">linux</LidGuardTargetPlatform>
    <LidGuardTargetPlatform Condition="'$(LidGuardTargetPlatform)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">macOS</LidGuardTargetPlatform>
    <LidGuardIsWindowsTarget Condition="'$(LidGuardTargetPlatform)' == 'windows'">true</LidGuardIsWindowsTarget>
    <LidGuardIsLinuxTarget Condition="'$(LidGuardTargetPlatform)' == 'linux'">true</LidGuardIsLinuxTarget>
    <LidGuardIsMacOSTarget Condition="'$(LidGuardTargetPlatform)' == 'macOS'">true</LidGuardIsMacOSTarget>
    <DefineConstants Condition="'$(LidGuardIsLinuxTarget)' == 'true'">$(DefineConstants);LIDGUARD_LINUX</DefineConstants>
    <DefineConstants Condition="'$(LidGuardIsMacOSTarget)' == 'true'">$(DefineConstants);LIDGUARD_MACOS</DefineConstants>
    <DefineConstants Condition="'$(LidGuardIsWindowsTarget)' == 'true'">$(DefineConstants);LIDGUARD_WINDOWS</DefineConstants>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lidguard</ToolCommandName>
    <PackageId>lidguard</PackageId>
    <Title>LidGuard</Title>
    <Authors>LidGuard Contributors</Authors>
    <Description>Command-line tool that keeps long-running local AI coding agent sessions awake on Windows, Linux, and macOS.</Description>
    <PackageTags>dotnet-tool;nativeaot;aot;windows;macos;linux;codex;claude;copilot;power;sleep;lid</PackageTags>
    <VersionPrefix>2.1.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildProjectDirectory)\..\artifacts\packages</PackageOutputPath>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <UsesWmiLight>false</UsesWmiLight>
    <UsesWmiLight Condition="'$(LidGuardIsWindowsTarget)' == 'true'">true</UsesWmiLight>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.WDK.Win32Metadata" Version="0.13.25-experimental" PrivateAssets="all" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.windows.cs" />
    <Compile Remove="**\*.linux.cs" />
    <Compile Remove="**\*.macOS.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsWindowsTarget)' != 'true'">
    <None Include="**\*.windows.cs" Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsLinuxTarget)' != 'true'">
    <None Include="**\*.linux.cs" Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsMacOSTarget)' != 'true'">
    <None Include="**\*.macOS.cs" Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsWindowsTarget)' == 'true'">
    <Compile Include="**\*.windows.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsLinuxTarget)' == 'true'">
    <Compile Include="**\*.linux.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsMacOSTarget)' == 'true'">
    <Compile Include="**\*.macOS.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(LidGuardIsWindowsTarget)' == 'true'">
    <PackageReference Include="WmiLight" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsesWmiLight)' == 'true'">
    <TrimmerRootAssembly Include="WmiLight" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
