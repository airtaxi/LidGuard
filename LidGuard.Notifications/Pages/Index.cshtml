@page
@model IndexModel
@{
    ViewData["Title"] = LidGuardNotificationText.DashboardTitle;
    var commandWebhookUrl = Model.HasPublicBaseUrl ? Model.WebhookUrl : $"https://your-host{Model.WebhookUrl}";
    var preSuspendWebhookCommand = $"lidguard settings --pre-suspend-webhook-url \"{commandWebhookUrl}\"";
    var postSessionEndWebhookCommand = $"lidguard settings --post-session-end-webhook-url \"{commandWebhookUrl}\"";
    var closedLidStopFollowUpWebhookCommand = $"lidguard settings --closed-lid-stop-follow-up-webhook-url \"{commandWebhookUrl}\"";
}

<section
    id="notificationDashboard"
    class="dashboard-grid"
    data-service-workers-unavailable="@LidGuardNotificationText.ServiceWorkersUnavailable"
    data-web-push-unavailable="@LidGuardNotificationText.WebPushUnavailable"
    data-vapid-public-key-load-failed="@LidGuardNotificationText.VapidPublicKeyLoadFailed"
    data-notification-permission-not-granted="@LidGuardNotificationText.NotificationPermissionNotGranted"
    data-browser-subscribed="@LidGuardNotificationText.BrowserSubscribed"
    data-subscription-failed="@LidGuardNotificationText.SubscriptionFailed"
    data-browser-not-subscribed="@LidGuardNotificationText.BrowserNotSubscribed"
    data-browser-unsubscribed="@LidGuardNotificationText.BrowserUnsubscribed"
    data-unsubscribe-failed="@LidGuardNotificationText.UnsubscribeFailed"
    data-copy-label="@LidGuardNotificationText.CopyButton"
    data-copied-label="@LidGuardNotificationText.CopiedButton"
    data-copy-failed-label="@LidGuardNotificationText.CopyFailedButton">
    <div class="panel">
        <h1>@LidGuardNotificationText.Brand</h1>
        <div class="metric-row">
            <span>@LidGuardNotificationText.ActiveSubscriptionsLabel</span>
            <strong id="activeSubscriptionCount">@Model.ActiveSubscriptionCount</strong>
        </div>
        <div class="button-row">
            <button id="subscribeButton" type="button">@LidGuardNotificationText.SubscribeBrowserButton</button>
            <button id="unsubscribeButton" type="button" class="secondary">@LidGuardNotificationText.UnsubscribeButton</button>
        </div>
        <p id="subscriptionStatus" class="status-text" role="status">@LidGuardNotificationText.ReadyStatus</p>
    </div>

    <div class="panel">
        <h2>@LidGuardNotificationText.LidGuardWebhookTitle</h2>
        <code class="webhook-url">@Model.WebhookUrl</code>
        @if (!Model.HasPublicBaseUrl)
        {
            <p class="muted">@LidGuardNotificationText.PublicBaseUrlNotConfigured</p>
        }

        <h3>@LidGuardNotificationText.CommandExamplesTitle</h3>
        <div class="command-example-list">
            <div class="command-example">
                <span>@LidGuardNotificationText.PreSuspendWebhookCommandLabel</span>
                <code>@preSuspendWebhookCommand</code>
                <button
                    type="button"
                    class="secondary copy-button icon-button"
                    data-copy-text="@preSuspendWebhookCommand"
                    data-state="idle"
                    aria-label="@LidGuardNotificationText.CopyButton"
                    title="@LidGuardNotificationText.CopyButton">
                    <span class="icon icon-copy copy-icon copy-icon-idle" aria-hidden="true"></span>
                    <span class="icon icon-check copy-icon copy-icon-copied" aria-hidden="true"></span>
                    <span class="icon icon-triangle-alert copy-icon copy-icon-failed" aria-hidden="true"></span>
                </button>
            </div>
            <div class="command-example">
                <span>@LidGuardNotificationText.PostSessionEndWebhookCommandLabel</span>
                <code>@postSessionEndWebhookCommand</code>
                <button
                    type="button"
                    class="secondary copy-button icon-button"
                    data-copy-text="@postSessionEndWebhookCommand"
                    data-state="idle"
                    aria-label="@LidGuardNotificationText.CopyButton"
                    title="@LidGuardNotificationText.CopyButton">
                    <span class="icon icon-copy copy-icon copy-icon-idle" aria-hidden="true"></span>
                    <span class="icon icon-check copy-icon copy-icon-copied" aria-hidden="true"></span>
                    <span class="icon icon-triangle-alert copy-icon copy-icon-failed" aria-hidden="true"></span>
                </button>
            </div>
            <div class="command-example">
                <span>@LidGuardNotificationText.ClosedLidStopFollowUpWebhookCommandLabel</span>
                <code>@closedLidStopFollowUpWebhookCommand</code>
                <button
                    type="button"
                    class="secondary copy-button icon-button"
                    data-copy-text="@closedLidStopFollowUpWebhookCommand"
                    data-state="idle"
                    aria-label="@LidGuardNotificationText.CopyButton"
                    title="@LidGuardNotificationText.CopyButton">
                    <span class="icon icon-copy copy-icon copy-icon-idle" aria-hidden="true"></span>
                    <span class="icon icon-check copy-icon copy-icon-copied" aria-hidden="true"></span>
                    <span class="icon icon-triangle-alert copy-icon copy-icon-failed" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</section>

<script src="~/app.js" asp-append-version="true"></script>
