@{
    var currentLanguageName = LidGuardNotificationCulture.ResolveSelectableCultureName(CultureInfo.CurrentUICulture);
    var currentReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}";
    var languageAction = $"{Context.Request.PathBase}/language";
    var initialThemeSwitchLabel = LidGuardNotificationText.ThemeSwitchTo(LidGuardNotificationText.ThemeDarkMode.ToLower(CultureInfo.CurrentCulture));
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @LidGuardNotificationText.Brand</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <script src="~/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a asp-page="/Index" class="brand">@LidGuardNotificationText.Brand</a>
        <div class="header-actions">
            <form method="post" action="@languageAction" class="language-form">
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                <label for="languageSelect" class="visually-hidden">@LidGuardNotificationText.LanguageLabel</label>
                <span class="language-select-shell">
                    <span class="icon icon-globe control-icon" aria-hidden="true"></span>
                    <select
                        id="languageSelect"
                        name="culture"
                        class="language-select"
                        aria-label="@LidGuardNotificationText.LanguageLabel"
                        title="@LidGuardNotificationText.LanguageLabel"
                        onchange="this.form.submit()">
                        <option value="en" selected="@(currentLanguageName == "en")">@LidGuardNotificationText.LanguageEnglish</option>
                        <option value="ko" selected="@(currentLanguageName == "ko")">@LidGuardNotificationText.LanguageKorean</option>
                        <option value="ja" selected="@(currentLanguageName == "ja")">@LidGuardNotificationText.LanguageJapanese</option>
                        <option value="zh-Hans" selected="@(currentLanguageName == "zh-Hans")">@LidGuardNotificationText.LanguageSimplifiedChinese</option>
                        <option value="zh-Hant" selected="@(currentLanguageName == "zh-Hant")">@LidGuardNotificationText.LanguageTraditionalChinese</option>
                    </select>
                    <span class="icon icon-chevron-down select-chevron" aria-hidden="true"></span>
                </span>
            </form>
            <button
                id="themeToggle"
                type="button"
                class="theme-toggle icon-button"
                aria-label="@initialThemeSwitchLabel"
                title="@initialThemeSwitchLabel"
                data-dark-mode-label="@LidGuardNotificationText.ThemeDarkMode"
                data-light-mode-label="@LidGuardNotificationText.ThemeLightMode"
                data-switch-to-format="@LidGuardNotificationText.ThemeSwitchToFormat"
                data-next-theme="dark"
                data-theme-state="light">
                <span class="icon icon-moon theme-icon theme-icon-moon" aria-hidden="true"></span>
                <span class="icon icon-sun theme-icon theme-icon-sun" aria-hidden="true"></span>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav>
                    <a asp-page="/Index">@LidGuardNotificationText.DashboardTitle</a>
                    <a asp-page="/Events">@LidGuardNotificationText.EventsTitle</a>
                    <form method="post" action="/logout">
                        <button type="submit" class="link-button">@LidGuardNotificationText.SignOutNavigation</button>
                    </form>
                </nav>
            }
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
