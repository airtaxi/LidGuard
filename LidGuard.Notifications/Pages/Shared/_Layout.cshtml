<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LidGuard Notifications</title>
    <script src="~/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a asp-page="/Index" class="brand">LidGuard Notifications</a>
        <div class="header-actions">
            <button id="themeToggle" type="button" class="theme-toggle" aria-label="Switch color theme">Dark mode</button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav>
                    <a asp-page="/Index">Dashboard</a>
                    <a asp-page="/Events">Events</a>
                    <form method="post" action="/logout">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                </nav>
            }
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
