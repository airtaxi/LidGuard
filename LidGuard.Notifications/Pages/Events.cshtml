@page
@model EventsModel
@{
    ViewData["Title"] = LidGuardNotificationText.EventsTitle;
    var nextBeforeWebhookEventIdentifier = Model.EventPage.NextBeforeWebhookEventIdentifier?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
}

<section
    class="events-page"
    data-events-page
    data-more-url="@Url.Page("/Events", "More")"
    data-details-url="@Url.Page("/Events", "Details")"
    data-events-loading="@LidGuardNotificationText.EventsLoading"
    data-events-load-more="@LidGuardNotificationText.EventsLoadMore"
    data-events-load-failed="@LidGuardNotificationText.EventsLoadFailed"
    data-event-details-load-failed="@LidGuardNotificationText.EventDetailsLoadFailed"
    data-recent-events-format="@LidGuardNotificationText.RecentEventsFormat">
    <div class="page-heading">
        <h1>@LidGuardNotificationText.WebhookEventsHeading</h1>
        <span class="muted" data-recent-events-count>@LidGuardNotificationText.RecentEvents(Model.EventPage.Events.Count)</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.EventMessage))
    {
        <p class="muted">@Model.EventMessage</p>
    }
    @if (Model.EventPage.Events.Count == 0)
    {
        <p class="muted">@LidGuardNotificationText.NoEventsRecorded</p>
    }
    else
    {
        <div class="event-list" data-event-list>
            <partial name="_WebhookEventCardList" model="Model.EventPage" />
        </div>
        <div class="load-more-row">
            <button type="button" class="secondary load-more-events" data-load-more-events data-before-webhook-event-identifier="@nextBeforeWebhookEventIdentifier" hidden="@(!Model.EventPage.HasMore)">@LidGuardNotificationText.EventsLoadMore</button>
            <p class="muted event-load-error" data-events-error hidden></p>
        </div>
    }
</section>

<script src="~/local-time.js" asp-append-version="true"></script>
<script src="~/events.js" asp-append-version="true"></script>
